{
  "name": "politex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Учебный портал «Проектирование информационных систем» — React + Express + PostgreSQL",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install",

    "dev": "concurrently -n \"API,WEB\" -c \"yellow,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",

    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",

    "start": "npm run start --workspace=backend",
    "start:backend": "npm run start --workspace=backend",
    "preview:frontend": "npm run preview --workspace=frontend",

    "clean": "rimraf node_modules frontend/node_modules backend/node_modules frontend/dist backend/dist",

    "lint": "npm run lint --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "rimraf": "^6.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}